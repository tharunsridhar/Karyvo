    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
