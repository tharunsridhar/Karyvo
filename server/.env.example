# PostgreSQL connection string
DATABASE_URL=postgresql://karyvo:karyvo@localhost:5432/karyvo
# At least 16 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Set true when served over HTTPS so the session cookie is Secure
COOKIE_SECURE=false
# Pending booking requests expire after this many minutes
PENDING_TTL_MINUTES=1440
# Customers cannot cancel an accepted booking within this many hours of the start
CANCEL_CUTOFF_HOURS=24
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_MAX=20
# Optional: path to the built frontend so the API serves it (used in Docker)
WEB_DIST=

# Free-hosting protection (see README). When a limit is hit the API answers 503 "server is full".
MAX_USERS=300
MAX_BOOKINGS=2000
MAX_SERVICES=300
# API calls per UTC day across all visitors. Resets at midnight UTC.
DAILY_REQUEST_BUDGET=60000
# Calls per minute per visitor IP
API_RATE_MAX=240
# 0 turns the background expiry sweep off so a free database can sleep
SWEEP_INTERVAL_SECONDS=60
# Delete visitor-created accounts and their data older than this many hours (0 = off). Demo accounts are kept.
DEMO_CLEANUP_HOURS=0
