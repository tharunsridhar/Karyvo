# PostgreSQL connection string
DATABASE_URL=postgresql://karyvo:karyvo@localhost:5432/karyvo
# At least 16 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Set true when served over HTTPS so the session cookie is Secure
COOKIE_SECURE=false
# Pending booking requests expire after this many minutes
PENDING_TTL_MINUTES=1440
# Customers cannot cancel an accepted booking within this many hours of the start
CANCEL_CUTOFF_HOURS=24
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_MAX=20
# Optional: path to the built frontend so the API serves it (used in Docker)
WEB_DIST=
